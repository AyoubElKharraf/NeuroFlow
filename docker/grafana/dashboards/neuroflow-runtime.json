{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "title": "JVM Heap",
      "type": "timeseries",
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{area=\"heap\",service=\"neuroflow-backend\"}",
          "legendFormat": "used",
          "refId": "A"
        },
        {
          "expr": "jvm_memory_max_bytes{area=\"heap\",service=\"neuroflow-backend\"}",
          "legendFormat": "max",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "title": "CPU Usage",
      "type": "timeseries",
      "targets": [
        {
          "expr": "process_cpu_usage{service=\"neuroflow-backend\"}",
          "legendFormat": "process",
          "refId": "A"
        },
        {
          "expr": "system_cpu_usage{service=\"neuroflow-backend\"}",
          "legendFormat": "system",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "title": "HTTP Request Rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{service=\"neuroflow-backend\"}[1m]))",
          "legendFormat": "req/s",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "title": "NeuroFlow Counters",
      "type": "timeseries",
      "targets": [
        {
          "expr": "neuroflow_simulation_emitted_total{service=\"neuroflow-backend\"}",
          "legendFormat": "simulation emitted",
          "refId": "A"
        },
        {
          "expr": "neuroflow_alerts_published_total{service=\"neuroflow-backend\"}",
          "legendFormat": "alerts published",
          "refId": "B"
        },
        {
          "expr": "neuroflow_drift_checks_total{service=\"neuroflow-backend\"}",
          "legendFormat": "drift checks",
          "refId": "C"
        },
        {
          "expr": "neuroflow_drift_detected_total{service=\"neuroflow-backend\"}",
          "legendFormat": "drift detected",
          "refId": "D"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["neuroflow", "mlops"],
  "templating": { "list": [] },
  "time": { "from": "now-30m", "to": "now" },
