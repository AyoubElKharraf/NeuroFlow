# NeuroFlow — centralized local environment (copy to .env)
# cp .env.example .env

# ── PostgreSQL ──────────────────────────────────────────
POSTGRES_DB=neuroflow_db
POSTGRES_USER=neuroflow
POSTGRES_PASSWORD=neuroflow
POSTGRES_PORT=5433
POSTGRES_URL=jdbc:postgresql://localhost:5433/neuroflow_db

# ── ClickHouse ──────────────────────────────────────────
CLICKHOUSE_DB=neuroflow_analytics
CLICKHOUSE_USER=neuroflow
CLICKHOUSE_PASSWORD=neuroflow
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_URL=jdbc:clickhouse://localhost:8123/neuroflow_analytics

# ── Kafka / Zookeeper ───────────────────────────────────
ZOOKEEPER_PORT=2181
KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ── Redis ───────────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ── Application ports (Phases 2–4) ──────────────────────
BACKEND_PORT=8080
ANALYTICS_PORT=8000
UI_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_ANALYTICS_URL=http://localhost:8000
